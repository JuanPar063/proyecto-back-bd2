// ============================================================
// Prisma schema — Plataforma SQL Judge
// Modelo de dominio inicial para la Entrega 1.
// Mantener en línea con docs/ARCHITECTURE.md (modelo de dominio).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS / AUTH (módulo Sofia)
// ============================================================

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursesTaught      Course[]            @relation("CourseProfessor")
  enrollments        Enrollment[]
  challengesOwned    Challenge[]         @relation("ChallengeAuthor")
  submissions        Submission[]
  evaluationAttempts EvaluationAttempt[]

  @@index([role])
  @@map("users")
}

// ============================================================
// COURSES (módulo redelegado a Sofia)
// ============================================================

model Course {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  period      String
  groupName   String   @map("group")
  professorId String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professor   User         @relation("CourseProfessor", fields: [professorId], references: [id])
  enrollments Enrollment[]
  challenges  Challenge[]
  evaluations Evaluation[]

  @@index([professorId])
  @@map("courses")
}

model Enrollment {
  id         String   @id @default(uuid())
  courseId   String
  studentId  String
  enrolledAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("enrollments")
}

// ============================================================
// CHALLENGES / SQL RETOS (módulo redelegado a Ruiz)
// ============================================================

enum ChallengeStatus {
  draft
  published
  archived
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum DatabaseEngine {
  postgresql
  mysql
  sqlite
}

model Challenge {
  id             String          @id @default(uuid())
  title          String
  description    String          @db.Text
  difficulty     Difficulty
  tags           String[]
  databaseEngine DatabaseEngine  @default(postgresql)
  timeLimit      Int             @default(2000) // ms
  status         ChallengeStatus @default(draft)
  courseId       String
  createdById    String
  expectedResult Json?           // Resultado esperado en formato JSON (array de objetos)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  course         Course                @relation(fields: [courseId], references: [id])
  createdBy      User                  @relation("ChallengeAuthor", fields: [createdById], references: [id])
  schema         SchemaScript?
  testDatasets   TestDataset[]
  submissions    Submission[]
  expectedResult ExpectedResult?
  evaluations    EvaluationChallenge[]

  @@index([courseId, status])
  @@index([status])
  @@map("challenges")
}

// ============================================================
// SCHEMAS / TEST DATA (módulo Ruiz)
// ============================================================

model SchemaScript {
  id           String   @id @default(uuid())
  challengeId  String   @unique
  ddl          String   @db.Text // CREATE TABLE ...
  parsedTables Json? // metadata de tablas/columnas detectadas
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("schema_scripts")
}

enum TestDatasetKind {
  MANUAL_INSERT
  GENERATOR_CONFIG
}

model TestDataset {
  id              String          @id @default(uuid())
  challengeId     String
  name            String
  kind            TestDatasetKind
  // Si kind = MANUAL_INSERT -> sql contiene los INSERT
  // Si kind = GENERATOR_CONFIG -> generatorConfig tiene la config JSON
  sql             String?         @db.Text
  generatorConfig Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("test_datasets")
}

// ============================================================
// SUBMISSIONS (Entrega 2 — módulo Ruiz)
// Extiende la entidad mínima de Entrega 1 con:
//   - engineVersion: versión del motor usado por el Runner.
//   - runnerMetadata: payload técnico devuelto por el Runner (rows,
//     columns, explainPlan, etc.). Documentado en docs/CONTRACTS.md.
//   - feedback: explicación enriquecida (humana) que produce el
//     comparador + el asistente IA y se muestra al estudiante.
// ============================================================

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  SYNTAX_ERROR
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  OPTIMIZATION_REQUIRED
}

enum EvaluationResultsVisibility {
  DURING_EVALUATION
  AFTER_END
  ALWAYS
}

model Submission {
  id                  String           @id @default(uuid())
  studentId           String
  challengeId         String
  evaluationAttemptId String?
  engine              DatabaseEngine   @default(postgresql)
  engineVersion       String?
  query               String           @db.Text
  status              SubmissionStatus @default(QUEUED)
  score               Int?
  executionTimeMs     Int?
  errorMessage        String?          @db.Text
  feedback            String?          @db.Text
  runnerMetadata      Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  student           User               @relation(fields: [studentId], references: [id])
  challenge         Challenge          @relation(fields: [challengeId], references: [id])
  evaluationAttempt EvaluationAttempt? @relation(fields: [evaluationAttemptId], references: [id], onDelete: SetNull)

  @@index([studentId, challengeId])
  @@index([evaluationAttemptId])
  @@index([status])
  @@map("submissions")
}

// ============================================================
// EVALUATIONS / PARCIALES (Entrega 2 — módulo Sofia)
// Una evaluación agrupa retos de un curso, limita ventanas de tiempo
// e intentos, y conecta los submissions del estudiante con un intento.
// ============================================================

model Evaluation {
  id                String                      @id @default(uuid())
  name              String
  description       String?                     @db.Text
  courseId          String
  startDate         DateTime
  endDate           DateTime
  durationMinutes   Int
  maxAttempts       Int                         @default(1)
  resultsVisibility EvaluationResultsVisibility @default(AFTER_END)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  course     Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  challenges EvaluationChallenge[]
  attempts   EvaluationAttempt[]

  @@index([courseId])
  @@index([startDate, endDate])
  @@map("evaluations")
}

model EvaluationChallenge {
  id           String @id @default(uuid())
  evaluationId String
  challengeId  String
  position     Int

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  challenge  Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, challengeId])
  @@unique([evaluationId, position])
  @@index([challengeId])
  @@map("evaluation_challenges")
}

model EvaluationAttempt {
  id            String    @id @default(uuid())
  evaluationId  String
  studentId     String
  attemptNumber Int
  startedAt     DateTime  @default(now())
  endsAt        DateTime
  submittedAt   DateTime?

  evaluation  Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([evaluationId, studentId, attemptNumber])
  @@index([studentId])
  @@index([evaluationId, studentId])
  @@map("evaluation_attempts")
}

// ============================================================
// EXPECTED RESULT (Entrega 2 — módulo Ruiz)
// Resultado de referencia (columnas + filas) que el comparador
// usa para decidir ACCEPTED / WRONG_ANSWER. Uno por reto, lo
// carga el profesor cuando publica el reto.
//   - orderSensitive: si true, la comparación respeta orden de filas.
//   - floatTolerance: tolerancia absoluta para comparar decimales.
// ============================================================

model ExpectedResult {
  id             String   @id @default(uuid())
  challengeId    String   @unique
  columns        String[]
  rows           Json
  orderSensitive Boolean  @default(false)
  floatTolerance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("expected_results")
}
