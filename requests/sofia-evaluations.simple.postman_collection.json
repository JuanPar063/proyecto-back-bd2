  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login PROFESSOR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login professor 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('profToken', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{profEmail}}\",\n  \"password\": \"{{profPassword}}\"\n}"
            },
            "url": "{{host}}/auth/login"
          }
        },
        {
          "name": "Login STUDENT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login student 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('studentToken', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{host}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "02 Professor - Evaluations CRUD",
      "item": [
        {
          "name": "Create evaluation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('evaluation created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('evaluationId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{profToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Parcial 1 - Consultas SQL\",\n  \"description\": \"Evaluacion de joins, filtros y agregaciones.\",\n  \"courseId\": \"{{courseId}}\",\n  \"startDate\": \"2026-05-26T00:00:00.000Z\",\n  \"endDate\": \"2026-12-31T23:59:59.000Z\",\n  \"durationMinutes\": 90,\n  \"maxAttempts\": 2,\n  \"resultsVisibility\": \"AFTER_END\"\n}"
            },
            "url": "{{host}}/evaluations"
