        },
        {
          "name": "Submit challenge inside evaluation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('submission accepted by API queue', function () { pm.response.to.have.status(202); });",
