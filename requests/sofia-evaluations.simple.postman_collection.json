            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"SELECT c.name, COUNT(o.id) AS total FROM customers c JOIN orders o ON o.customer_id = c.id GROUP BY c.name HAVING COUNT(o.id) > 3\",\n  \"evaluationId\": \"{{evaluationId}}\"\n}"
            },
            "url": "{{host}}/challenges/{{challengeId}}/submissions"
