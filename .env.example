# ============================================
# Aplicación
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=docs

# ============================================
# Base de datos principal (PostgreSQL)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sqljudge
POSTGRES_PASSWORD=sqljudge_dev_password
POSTGRES_DB=sqljudge
# DATABASE_URL la consume Prisma directamente
DATABASE_URL=postgresql://sqljudge:sqljudge_dev_password@postgres:5432/sqljudge?schema=public

# Base usada para evaluaciones temporales (la creará el runner en Entrega 2)
EVAL_POSTGRES_DB=sqljudge_eval

# ============================================
# Redis / BullMQ
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT
# ============================================
JWT_SECRET=cambia-este-secreto-en-produccion-por-favor
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Bcrypt
# ============================================
BCRYPT_ROUNDS=10

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*

# ============================================
# Asistente IA (Pardo, Entrega 2)
# Proveedores soportados: stub | openai | anthropic | ollama
# Con "stub" el sistema funciona sin red ni API keys.
# ============================================
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
AI_SLOW_QUERY_THRESHOLD_MS=800
