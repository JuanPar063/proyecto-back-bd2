# ============================================================
# .dockerignore — evita que `COPY . .` arrastre artefactos
# locales de build / IDE / git al contexto de docker build.
# Sin esto, el cache incremental de TypeScript del host se
# copia al contenedor y `nest build` no regenera dist/main.js.
# ============================================================

# Dependencias y artefactos de build
node_modules
dist
dist-worker
*.tsbuildinfo

# Git
.git
.gitignore

# IDE / OS
.vscode
.idea
.DS_Store
*.swp

# Tests / coverage
coverage
.nyc_output

# Logs
*.log
logs

# Variables locales (las inyecta docker-compose vía env_file)
.env
.env.local
.env.*.local

# Documentación / colecciones de pruebas — no se necesitan en runtime
docs
requests
scripts
